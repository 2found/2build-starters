{
  "schema_version": 1,
  "source": "2found/2build-starters",
  "version": "0.2.0",
  "min_cli_version": "1.118.0",
  "templates": {
    "hono-bun": {
      "path": "templates/hono-bun",
      "revision": 2,
      "summary": "Harness aligned with 2build harness-audit: template-owned AGENTS.md with run/verify/deploy map, docs/ARCHITECTURE-API.md and an expanded verification contract.",
      "upgrade": "upgrades/hono-bun.md",
      "dev": [
        "bun",
        "run",
        "dev"
      ],
      "verify": [
        [
          "bun",
          "install",
          "--frozen-lockfile"
        ],
        [
          "bun",
          "run",
          "typecheck"
        ],
        [
          "bun",
          "run",
          "test"
        ],
        [
          "bun",
          "run",
          "build"
        ]
      ]
    },
    "nextjs-pnpm": {
      "path": "templates/nextjs-pnpm",
      "revision": 1,
      "summary": "Next.js App Router web app scaffolded by create-next-app@latest at bootstrap, with docs/ARCHITECT-WEB.md, DESIGN.md tokens, TanStack Query load-limit defaults, apiFetch and a verified 2build harness.",
      "upgrade": "upgrades/nextjs-pnpm.md",
      "scaffold": [
        [
          "pnpm",
          "dlx",
          "create-next-app@latest",
          ".",
          "--ts",
          "--tailwind",
          "--eslint",
          "--app",
          "--no-src-dir",
          "--import-alias",
          "@/*",
          "--use-pnpm",
          "--disable-git",
          "--yes"
        ],
        [
          "pnpm",
          "add",
          "@tanstack/react-query",
          "zod"
        ],
        [
          "pnpm",
          "add",
          "--save-dev",
          "vitest",
          "@types/node@latest"
        ],
        [
          "pnpm",
          "pkg",
          "set",
          "scripts.dev=next dev --port ${PORT:-3100}",
          "scripts.start=next start --port ${PORT:-3100}",
          "scripts.typecheck=next typegen && tsc --noEmit",
          "scripts.test=vitest run"
        ]
      ],
      "dev": [
        "pnpm",
        "dev"
      ],
      "verify": [
        [
          "pnpm",
          "install",
          "--frozen-lockfile"
        ],
        [
          "pnpm",
          "run",
          "lint"
        ],
        [
          "pnpm",
          "run",
          "typecheck"
        ],
        [
          "pnpm",
          "test"
        ],
        [
          "pnpm",
          "run",
          "build"
        ]
      ]
    }
  }
}
